{
  "name": "threadcrate",
  "description": "Save Reddit threads, subreddits past the 1000-post limit, profiles and searches as CSV, JSON and Markdown. Free and open source.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/jasp-nerd/threadcrate",
  "repository": "github:jasp-nerd/threadcrate",
  "bugs": "https://github.com/jasp-nerd/threadcrate/issues",
  "author": "jasp-nerd",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test --project e2e",
    "live": "wxt build && playwright test --project live",
    "live:login": "node --experimental-strip-types e2e/live/login.ts",
    "media": "wxt build && playwright test --project store",
    "icons": "node --experimental-strip-types media/icons.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e",
    "check:manifest": "wxt build && wxt build -b firefox && node scripts/check-manifest.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@webext-core/messaging": "^4.0.0",
    "client-zip": "^2.5.1",
    "svelte": "^5.57.2",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
