---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
import sleep from '../../../public/kip/sleep.webp';
---

<Base title="Page not found – Threadcrate for Reddit" description="This page doesn't exist." noindex>
  <section class="wrap not-found">
    <img src={sleep.src} width="180" height={Math.round((180 * sleep.height) / sleep.width)} alt="Kip, the extension's otter, asleep" />
    <h1 style="font-size: clamp(36px, 5vw, 60px); letter-spacing: -0.04em">This page isn't here</h1>
    <p class="lead muted">It may have moved, or the link has a typo.</p>
    <p class="cta-row">
      <a class="btn btn-primary" href={href('/')}>Go to the home page</a>
      <a class="link-plain" href={href('/how-to-export-reddit-to-csv/')}>Export Reddit to CSV</a>
    </p>
  </section>
</Base>
